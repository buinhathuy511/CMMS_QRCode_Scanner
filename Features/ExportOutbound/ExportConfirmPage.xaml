<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:CMMS_QRCode_Scanner.Features.ExportOutbound"
             xmlns:models="clr-namespace:CMMS_QRCode_Scanner.Models"
             x:Class="CMMS_QRCode_Scanner.Features.ExportOutbound.ExportConfirmPage"
             x:DataType="vm:ExportConfirmViewModel"
             Title="{Binding Title}"
             BackgroundColor="{StaticResource OffWhite}">

    <Grid>
        <!-- Main Content: Confirm before submit -->
        <ScrollView IsVisible="{Binding IsNotSuccess}">

            <VerticalStackLayout Padding="16" Spacing="16">

                <!-- Summary Card -->
                <Border Stroke="{StaticResource Primary}" StrokeThickness="2"
                        StrokeShape="RoundRectangle 12" Padding="20" BackgroundColor="White">
                    <VerticalStackLayout Spacing="14">
                        <Label Text="Thông tin phiếu xuất"
                               FontSize="18" FontAttributes="Bold" TextColor="{StaticResource Primary}" />

                        <BoxView HeightRequest="1" Color="{StaticResource LightGray}" />

                        <!-- Movement Type -->
                        <Grid ColumnDefinitions="Auto, *" ColumnSpacing="12">
                            <Label Grid.Column="0" Text="Hình thức xuất:"
                                   FontSize="14" TextColor="{StaticResource Secondary}" />
                            <Label Grid.Column="1" Text="{Binding MovementTypeName}"
                                   FontSize="14" FontAttributes="Bold" TextColor="{StaticResource OffBlack}" />
                        </Grid>

                        <!-- Export Date -->
                        <Grid ColumnDefinitions="Auto, *" ColumnSpacing="12">
                            <Label Grid.Column="0" Text="Ngày xuất:"
                                   FontSize="14" TextColor="{StaticResource Secondary}" />
                            <Label Grid.Column="1" Text="{Binding ExportDateDisplay}"
                                   FontSize="14" FontAttributes="Bold" TextColor="{StaticResource OffBlack}" />
                        </Grid>

                        <!-- Total Items -->
                        <Grid ColumnDefinitions="Auto, *" ColumnSpacing="12">
                            <Label Grid.Column="0" Text="Tổng số item:"
                                   FontSize="14" TextColor="{StaticResource Secondary}" />
                            <Label Grid.Column="1" Text="{Binding TotalItems}"
                                   FontSize="14" FontAttributes="Bold" TextColor="{StaticResource OffBlack}" />
                        </Grid>

                        <!-- Total Quantity -->
                        <Grid ColumnDefinitions="Auto, *" ColumnSpacing="12">
                            <Label Grid.Column="0" Text="Tổng số lượng:"
                                   FontSize="14" TextColor="{StaticResource Secondary}" />
                            <Label Grid.Column="1" Text="{Binding TotalQuantity}"
                                   FontSize="16" FontAttributes="Bold" TextColor="{StaticResource Primary}" />
                        </Grid>
                    </VerticalStackLayout>
                </Border>

                <!-- Items Detail List -->
                <Label Text="Chi tiết phụ tùng" FontSize="16" FontAttributes="Bold"
                       TextColor="{StaticResource OffBlack}" Margin="0,4,0,0" />

                <VerticalStackLayout BindableLayout.ItemsSource="{Binding ConfirmItems}" Spacing="6">
                    <BindableLayout.ItemTemplate>
                        <DataTemplate x:DataType="models:ExportLineItem">
                            <Border Stroke="{StaticResource LightGray}" StrokeThickness="1"
                                    StrokeShape="RoundRectangle 8" Padding="12" Margin="0,1"
                                    BackgroundColor="White">
                                <Grid ColumnDefinitions="*, Auto" RowDefinitions="Auto, Auto" RowSpacing="4">
                                    <Label Grid.Row="0" Grid.Column="0"
                                           Text="{Binding PartSummary}"
                                           FontSize="14" FontAttributes="Bold" TextColor="{StaticResource OffBlack}" />

                                    <Label Grid.Row="0" Grid.Column="1"
                                           Text="{Binding QuantityDisplay}"
                                           FontSize="16" FontAttributes="Bold"
                                           TextColor="{StaticResource Primary}" HorizontalOptions="End" />

                                    <Label Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2"
                                           FontSize="12" TextColor="{StaticResource Secondary}"
                                           Text="{Binding DisplaySerial, StringFormat='Serial: {0}'}" />
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </BindableLayout.ItemTemplate>
                </VerticalStackLayout>

                <!-- Error Message -->
                <Border IsVisible="{Binding HasError}" BackgroundColor="#FFEBEE"
                        Stroke="#EF5350" StrokeThickness="1"
                        StrokeShape="RoundRectangle 8" Padding="14">
                    <VerticalStackLayout Spacing="6">
                        <Label Text="⚠️ Không thể xuất kho"
                               TextColor="#C62828" FontAttributes="Bold" FontSize="14" />
                        <Label Text="{Binding ErrorMessage}" TextColor="#B71C1C" FontSize="13"
                               LineBreakMode="WordWrap" />
                    </VerticalStackLayout>
                </Border>

                <!-- Action Buttons -->
                <Grid ColumnDefinitions="*, *" ColumnSpacing="12" Margin="0,8">
                    <Button Grid.Column="0" Text="Quay lại sửa"
                            Command="{Binding GoBackToEditCommand}"
                            BackgroundColor="#ECEFF1" TextColor="{StaticResource OffBlack}"
                            FontAttributes="Bold" CornerRadius="10" HeightRequest="48" />

                    <Button Grid.Column="1" Text="Xác nhận xuất"
                            Command="{Binding ConfirmExportCommand}"
                            BackgroundColor="{StaticResource SuccessColor}" TextColor="White"
                            FontAttributes="Bold" CornerRadius="10" HeightRequest="48" />
                </Grid>

            </VerticalStackLayout>
        </ScrollView>

        <!-- Success Result Screen -->
        <VerticalStackLayout IsVisible="{Binding IsSuccess}"
                             VerticalOptions="Center" HorizontalOptions="Center"
                             Spacing="20" Padding="30">
            <Border BackgroundColor="#E8F5E9" StrokeThickness="0"
                    StrokeShape="RoundRectangle 50"
                    WidthRequest="100" HeightRequest="100"
                    HorizontalOptions="Center">
                <Label Text="✓" FontSize="48" TextColor="#2E7D32"
                       HorizontalOptions="Center" VerticalOptions="Center" />
            </Border>

            <Label Text="Xuất kho thành công!"
                   FontSize="22" FontAttributes="Bold"
                   TextColor="#2E7D32" HorizontalOptions="Center" />

            <Border Stroke="{StaticResource LightGray}" StrokeThickness="1"
                    StrokeShape="RoundRectangle 10" Padding="20" BackgroundColor="White"
                    HorizontalOptions="Center" MinimumWidthRequest="280">
                <VerticalStackLayout Spacing="10" HorizontalOptions="Center">
                    <Label Text="Mã phiếu xuất:" FontSize="13"
                           TextColor="{StaticResource Secondary}" HorizontalOptions="Center" />
                    <Label Text="{Binding ResultExportCode}"
                           FontSize="20" FontAttributes="Bold"
                           TextColor="{StaticResource Primary}" HorizontalOptions="Center" />
                </VerticalStackLayout>
            </Border>

            <Button Text="Về trang chính"
                    Command="{Binding GoHomeCommand}"
                    BackgroundColor="{StaticResource Primary}" TextColor="White"
                    FontAttributes="Bold" CornerRadius="10" HeightRequest="48"
                    WidthRequest="250" HorizontalOptions="Center"
                    Margin="0,20,0,0" />
        </VerticalStackLayout>

        <!-- Loading Overlay -->
        <Grid BackgroundColor="#88000000" IsVisible="{Binding IsSubmitting}">
            <VerticalStackLayout VerticalOptions="Center" HorizontalOptions="Center" Spacing="12">
                <ActivityIndicator IsRunning="{Binding IsSubmitting}" Color="White" />
                <Label Text="Đang xử lý xuất kho..." TextColor="White" FontSize="14" />
            </VerticalStackLayout>
        </Grid>
    </Grid>

</ContentPage>
