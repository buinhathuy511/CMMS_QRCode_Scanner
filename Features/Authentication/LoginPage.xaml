<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewmodels="clr-namespace:CMMS_QRCode_Scanner.Features.Authentication"
             x:Class="CMMS_QRCode_Scanner.Features.Authentication.LoginPage"
             x:DataType="viewmodels:LoginViewModel"
             Title="{Binding Title}"
             Shell.NavBarIsVisible="False"
             BackgroundColor="White">

    <ScrollView>
        <Grid VerticalOptions="Center" Padding="30">
            <VerticalStackLayout Spacing="0">
                
                <!-- Welcome Back Text -->
                <Label Text="Welcome Back" 
                       FontAttributes="Bold"
                       FontSize="32"
                       TextColor="#190649"
                       HorizontalOptions="Start"/>

                <!-- Gradient Line -->
                <BoxView HeightRequest="4" 
                         WidthRequest="60" 
                         HorizontalOptions="Start" 
                         Margin="0,5,0,0">
                    <BoxView.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                            <GradientStop Color="#0066CC" Offset="0.0" />
                            <GradientStop Color="#00C0C0" Offset="1.0" />
                        </LinearGradientBrush>
                    </BoxView.Background>
                </BoxView>

                <!-- Subtitle -->
                <Label Text="Đăng nhập vào tài khoản của bạn" 
                       TextColor="#8A8A8E" 
                       FontSize="14"
                       Margin="0,15,0,40"
                       HorizontalOptions="Start"/>

                <!-- Login Form -->
                <VerticalStackLayout Spacing="20">
                    
                    <!-- WorkDay ID Border -->
                    <Border Stroke="#E5E7EB" StrokeThickness="1" StrokeShape="RoundRectangle 12" BackgroundColor="#FDFDFD" Padding="0">
                        <Grid ColumnDefinitions="Auto, *">
                            <Path Grid.Column="0" 
                                  Data="M12,12 C14.21,12 16,10.21 16,8 C16,5.79 14.21,4 12,4 C9.79,4 8,5.79 8,8 C8,10.21 9.79,12 12,12 Z M12,14 C9.33,14 4,15.34 4,18 L4,20 L20,20 L20,18 C20,15.34 14.67,14 12,14 Z" 
                                  Fill="Transparent" 
                                  Stroke="#A0A0A0" 
                                  StrokeThickness="1.5" 
                                  Aspect="Uniform" 
                                  WidthRequest="20" 
                                  HeightRequest="20" 
                                  Margin="15,0,5,0" 
                                  VerticalOptions="Center"/>
                            <Entry Grid.Column="1" 
                                   Placeholder="WorkDay ID" 
                                   Text="{Binding Username}" 
                                   PlaceholderColor="#A0A0A0"
                                   TextColor="#333333"
                                   BackgroundColor="Transparent"
                                   ReturnType="Next"
                                   Margin="0" />
                        </Grid>
                    </Border>

                    <!-- Password Border -->
                    <Border Stroke="#E5E7EB" StrokeThickness="1" StrokeShape="RoundRectangle 12" BackgroundColor="#FDFDFD" Padding="0">
                        <Grid ColumnDefinitions="Auto, *, Auto">
                            <Path Grid.Column="0" 
                                  Data="M18,8 L17,8 L17,6 C17,3.24 14.76,1 12,1 C9.24,1 7,3.24 7,6 L7,8 L6,8 C4.9,8 4,8.9 4,10 L4,20 C4,21.1 4.9,22 6,22 L18,22 C19.1,22 20,21.1 20,20 L20,10 C20,8.9 19.1,8 18,8 Z M9,6 C9,4.34 10.34,3 12,3 C13.66,3 15,4.34 15,6 L15,8 L9,8 L9,6 Z" 
                                  Fill="Transparent" 
                                  Stroke="#A0A0A0" 
                                  StrokeThickness="1.5" 
                                  Aspect="Uniform" 
                                  WidthRequest="20" 
                                  HeightRequest="20" 
                                  Margin="15,0,5,0" 
                                  VerticalOptions="Center"/>
                            
                            <Entry Grid.Column="1" 
                                   Placeholder="Password" 
                                   IsPassword="{Binding IsPasswordHidden}" 
                                   Text="{Binding Password}" 
                                   PlaceholderColor="#A0A0A0"
                                   TextColor="#333333"
                                   BackgroundColor="Transparent"
                                   ReturnType="Done"
                                   ReturnCommand="{Binding LoginCommand}"
                                   Margin="0"/>
                            
                            <ImageButton Grid.Column="2" 
                                         Source="show_password_icon.png" 
                                         Command="{Binding TogglePasswordVisibilityCommand}" 
                                         WidthRequest="24" 
                                         HeightRequest="24" 
                                         Margin="10,0,15,0" 
                                         BackgroundColor="Transparent"
                                         Opacity="0.5"
                                         VerticalOptions="Center"/>
                        </Grid>
                    </Border>

                    <!-- Error Message -->
                    <Label Text="{Binding ErrorMessage}" 
                           TextColor="{StaticResource ErrorColor}" 
                           IsVisible="{Binding HasError}" 
                           HorizontalOptions="Center"/>

                    <!-- Login Button -->
                    <Grid Margin="0,15,0,0">
                        <Button Text="Sign In" 
                                Command="{Binding LoginCommand}" 
                                IsEnabled="{Binding IsNotBusy}"
                                TextColor="White"
                                FontAttributes="Bold"
                                CornerRadius="12"
                                HeightRequest="50">
                            <Button.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                    <GradientStop Color="#2460D9" Offset="0.0" />
                                    <GradientStop Color="#08AEEA" Offset="1.0" />
                                </LinearGradientBrush>
                            </Button.Background>
                        </Button>
                        
                        <ActivityIndicator IsRunning="{Binding IsBusy}" 
                                           IsVisible="{Binding IsBusy}" 
                                           HorizontalOptions="Center" 
                                           VerticalOptions="Center"
                                           Color="White"/>
                    </Grid>
                    
                </VerticalStackLayout>
                
                <!-- Footer -->
                <Label Text="© 2026 AQUA Vietnam. All rights reserved." 
                       TextColor="#A0A0A0" 
                       FontSize="12"
                       HorizontalOptions="Center"
                       Margin="0,80,0,0"/>
                
            </VerticalStackLayout>
        </Grid>
    </ScrollView>
</ContentPage>

