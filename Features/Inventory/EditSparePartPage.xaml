<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewmodels="clr-namespace:CMMS_QRCode_Scanner.Features.Inventory"
             x:Class="CMMS_QRCode_Scanner.Features.Inventory.EditSparePartPage"
             x:DataType="viewmodels:EditSparePartViewModel"
             Title="{Binding Title}">

    <Shell.TitleView>
        <HorizontalStackLayout VerticalOptions="Center" Spacing="15" Margin="10,0,0,0">
            <Label Text="{Binding Title}" VerticalOptions="Center" TextColor="White" FontSize="18" FontAttributes="Bold" />
        </HorizontalStackLayout>
    </Shell.TitleView>

    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="15">
            <ActivityIndicator IsRunning="{Binding IsBusy}" IsVisible="{Binding IsBusy}" Color="{StaticResource Primary}" HorizontalOptions="Center" />

            <!-- Readonly Section Header -->
            <HorizontalStackLayout Spacing="8" Margin="0,0,0,5">
                <Label Text="&#x1F512;" FontSize="16" VerticalOptions="Center" />
                <Label Text="System Information" FontAttributes="Bold" FontSize="16" TextColor="{StaticResource Primary}" VerticalOptions="Center" />
            </HorizontalStackLayout>
            <BoxView HeightRequest="1" Color="{StaticResource Gray200}" Margin="0,0,0,10" />
            
            <Border Stroke="{StaticResource Gray200}" StrokeShape="RoundRectangle 8" Padding="15" BackgroundColor="#F9FAFB">
                <VerticalStackLayout Spacing="10">
                    <Grid ColumnDefinitions="*,*">
                        <VerticalStackLayout Grid.Column="0">
                            <Label Text="Barcode ID" FontSize="12" TextColor="{StaticResource Gray500}" />
                            <Label Text="{Binding EditableItem.BarcodeId}" FontAttributes="Bold" TextColor="#6B7280" />
                        </VerticalStackLayout>
                        <VerticalStackLayout Grid.Column="1" IsVisible="{Binding IsCoded}">
                            <Label Text="Serial Code" FontSize="12" TextColor="{StaticResource Gray500}" />
                            <Label Text="{Binding SerialCode}" FontAttributes="Bold" TextColor="#6B7280" />
                        </VerticalStackLayout>
                    </Grid>
                    <Grid ColumnDefinitions="*,*">
                        <VerticalStackLayout Grid.Column="0">
                            <Label Text="Quantity" FontSize="12" TextColor="{StaticResource Gray500}" />
                            <Label Text="{Binding EditableItem.Quantity}" FontAttributes="Bold" TextColor="#6B7280" />
                        </VerticalStackLayout>
                        <VerticalStackLayout Grid.Column="1">
                            <Label Text="Status" FontSize="12" TextColor="{StaticResource Gray500}" />
                            <Label Text="{Binding EditableItem.Status}" FontAttributes="Bold" TextColor="#6B7280" />
                        </VerticalStackLayout>
                    </Grid>
                    <Grid ColumnDefinitions="*,*">
                        <VerticalStackLayout Grid.Column="0">
                            <Label Text="Import Date" FontSize="12" TextColor="{StaticResource Gray500}" />
                            <Label Text="{Binding EditableItem.ImportDate}" FontAttributes="Bold" TextColor="#6B7280" />
                        </VerticalStackLayout>
                        <VerticalStackLayout Grid.Column="1">
                            <Label Text="Age (Days)" FontSize="12" TextColor="{StaticResource Gray500}" />
                            <Label Text="{Binding EditableItem.AgeDays}" FontAttributes="Bold" TextColor="#6B7280" />
                        </VerticalStackLayout>
                    </Grid>
                </VerticalStackLayout>
            </Border>

            <!-- Editable Section Header -->
            <HorizontalStackLayout Spacing="8" Margin="0,20,0,5">
                <Label Text="&#x270E;" FontSize="16" VerticalOptions="Center" TextColor="{StaticResource Primary}" />
                <Label Text="Editable Information" FontAttributes="Bold" FontSize="16" TextColor="{StaticResource Primary}" VerticalOptions="Center" />
            </HorizontalStackLayout>
            <BoxView HeightRequest="1" Color="{StaticResource Gray200}" Margin="0,0,0,10" />

            <VerticalStackLayout Spacing="5">
                <Label Text="Part Name *" FontSize="12" TextColor="{StaticResource Gray500}" />
                <Border Stroke="{StaticResource Gray300}" StrokeShape="RoundRectangle 6" BackgroundColor="White" Padding="10,0">
                    <Entry TextColor="#111827" Text="{Binding EditableItem.PartName}" Placeholder="Enter part name" BackgroundColor="Transparent" />
                </Border>
            </VerticalStackLayout>

            <VerticalStackLayout Spacing="5">
                <Label Text="Part Code *" FontSize="12" TextColor="{StaticResource Gray500}" />
                <Border Stroke="{StaticResource Gray300}" StrokeShape="RoundRectangle 6" BackgroundColor="White" Padding="10,0">
                    <Entry TextColor="#111827" Text="{Binding EditableItem.PartCode}" Placeholder="Enter part code" BackgroundColor="Transparent" />
                </Border>
            </VerticalStackLayout>

            <VerticalStackLayout Spacing="5">
                <Label Text="Specification" FontSize="12" TextColor="{StaticResource Gray500}" />
                <Border Stroke="{StaticResource Gray300}" StrokeShape="RoundRectangle 6" BackgroundColor="White" Padding="10,0">
                    <Entry TextColor="#111827" Text="{Binding EditableItem.Specification}" Placeholder="Enter specification" BackgroundColor="Transparent" />
                </Border>
            </VerticalStackLayout>

            <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                <VerticalStackLayout Grid.Column="0" Spacing="5">
                    <Label Text="Min Stock" FontSize="12" TextColor="{StaticResource Gray500}" />
                    <Border Stroke="{StaticResource Gray300}" StrokeShape="RoundRectangle 6" BackgroundColor="White" Padding="10,0">
                        <Entry TextColor="#111827" Text="{Binding EditableItem.MinStock}" Keyboard="Numeric" Placeholder="0" BackgroundColor="Transparent" />
                    </Border>
                </VerticalStackLayout>
                <VerticalStackLayout Grid.Column="1" Spacing="5">
                    <Label Text="Unit" FontSize="12" TextColor="{StaticResource Gray500}" />
                    <Border Stroke="{StaticResource Gray300}" StrokeShape="RoundRectangle 6" BackgroundColor="White" Padding="10,0">
                        <Entry TextColor="#111827" Text="{Binding EditableItem.Unit}" Placeholder="e.g. pcs" BackgroundColor="Transparent" />
                    </Border>
                </VerticalStackLayout>
            </Grid>

            <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                <VerticalStackLayout Grid.Column="0" Spacing="5">
                    <Label Text="Price" FontSize="12" TextColor="{StaticResource Gray500}" />
                    <Border Stroke="{StaticResource Gray300}" StrokeShape="RoundRectangle 6" BackgroundColor="White" Padding="10,0">
                        <Entry TextColor="#111827" Text="{Binding EditableItem.Price}" Keyboard="Numeric" Placeholder="0.00" BackgroundColor="Transparent" />
                    </Border>
                </VerticalStackLayout>
                <VerticalStackLayout Grid.Column="1" Spacing="5">
                    <Label Text="Location" FontSize="12" TextColor="{StaticResource Gray500}" />
                    <Border Stroke="{StaticResource Gray300}" StrokeShape="RoundRectangle 6" BackgroundColor="White" Padding="10,0">
                        <Entry TextColor="#111827" Text="{Binding EditableItem.Location}" Placeholder="e.g. A1" BackgroundColor="Transparent" />
                    </Border>
                </VerticalStackLayout>
            </Grid>

            <VerticalStackLayout Spacing="5">
                <Label Text="Supplier" FontSize="12" TextColor="{StaticResource Gray500}" />
                <Border Stroke="{StaticResource Gray300}" StrokeShape="RoundRectangle 6" BackgroundColor="White" Padding="10,0">
                    <Entry TextColor="#111827" Text="{Binding EditableItem.Supplier}" Placeholder="Enter supplier" BackgroundColor="Transparent" />
                </Border>
            </VerticalStackLayout>

            <VerticalStackLayout Spacing="5">
                <Label Text="Department" FontSize="12" TextColor="{StaticResource Gray500}" />
                <Border Stroke="{StaticResource Gray300}" StrokeShape="RoundRectangle 6" BackgroundColor="White" Padding="10,0">
                    <Entry TextColor="#111827" Text="{Binding EditableItem.Department}" Placeholder="Enter department" BackgroundColor="Transparent" />
                </Border>
            </VerticalStackLayout>

            <VerticalStackLayout Spacing="5">
                <Label Text="Note" FontSize="12" TextColor="{StaticResource Gray500}" />
                <Border Stroke="{StaticResource Gray300}" StrokeShape="RoundRectangle 6" BackgroundColor="White" Padding="10,0">
                    <Editor TextColor="#111827" Text="{Binding EditableItem.Note}" HeightRequest="80" Placeholder="Enter notes" BackgroundColor="Transparent" />
                </Border>
            </VerticalStackLayout>

            <Grid ColumnDefinitions="*,*" ColumnSpacing="15" Margin="0,20,0,30">
                <Button Grid.Column="0" Text="CANCEL" Command="{Binding CancelCommand}" BackgroundColor="{StaticResource Gray400}" />
                <Button Grid.Column="1" Text="SAVE" Command="{Binding SaveCommand}" BackgroundColor="{StaticResource Primary}" />
            </Grid>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
