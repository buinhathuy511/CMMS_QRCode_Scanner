<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewmodels="clr-namespace:CMMS_QRCode_Scanner.Features.Scanner.ManualEntry"
             x:Class="CMMS_QRCode_Scanner.Features.Scanner.ManualEntry.ManualIdPage"
             x:DataType="viewmodels:ManualIdViewModel"
             Title="{Binding Title}">

    <Shell.TitleView>
        <HorizontalStackLayout VerticalOptions="Center" Spacing="15" Margin="10,0,0,0">
            <Label Text="{Binding Title}" VerticalOptions="Center" TextColor="White" FontSize="18" FontAttributes="Bold" />
        </HorizontalStackLayout>
    </Shell.TitleView>

    <VerticalStackLayout Padding="30" Spacing="20">
        
        <Label Text="Enter Barcode ID" Style="{StaticResource SubHeadline}" HorizontalOptions="Start" />
        <Label Text="Example: VFMNTNC0001" TextColor="{StaticResource Gray500}" Margin="0,-10,0,10" />

        <Border Padding="0" Stroke="{StaticResource Gray200}" StrokeShape="RoundRectangle 12">
            <Entry x:Name="BarcodeEntry"
                   Placeholder="Barcode ID" 
                   Text="{Binding BarcodeId}" 
                   TextColor="Black"
                   Margin="10,0" 
                   ClearButtonVisibility="WhileEditing"
                   ReturnCommand="{Binding SearchCommand}" />
        </Border>

        <Label Text="{Binding ErrorMessage}" 
               TextColor="{StaticResource ErrorColor}" 
               IsVisible="{Binding HasError}" />

        <Button Text="SEARCH" 
                Command="{Binding SearchCommand}" 
                IsEnabled="{Binding IsNotBusy}"
                Clicked="SearchButton_Clicked"
                Margin="0,20,0,0" />
                
        <ActivityIndicator IsRunning="{Binding IsBusy}" 
                           IsVisible="{Binding IsBusy}" 
                           HorizontalOptions="Center" 
                           Color="{StaticResource Primary}"/>

    </VerticalStackLayout>

</ContentPage>

