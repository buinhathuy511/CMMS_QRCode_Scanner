<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewmodels="clr-namespace:CMMS_QRCode_Scanner.Features.Scanner.ImageScan"
             x:Class="CMMS_QRCode_Scanner.Features.Scanner.ImageScan.ScanFromImagePage"
             x:DataType="viewmodels:ScanFromImageViewModel"
             Title="{Binding Title}">

    <Shell.TitleView>
        <HorizontalStackLayout VerticalOptions="Center" Spacing="15" Margin="10,0,0,0">
            <Label Text="{Binding Title}" VerticalOptions="Center" TextColor="White" FontSize="18" FontAttributes="Bold" />
        </HorizontalStackLayout>
    </Shell.TitleView>

    <VerticalStackLayout Padding="24" Spacing="20" VerticalOptions="Center">

        <Label Text="Chọn hình ảnh chứa mã QR / Barcode" Style="{StaticResource SubHeadline}" HorizontalOptions="Start" />

        <Button Text="🖼️  CHỌN ẢNH TỪ THIẾT BỊ" 
                Command="{Binding SelectImageCommand}" 
                IsEnabled="{Binding IsNotBusy}"
                BackgroundColor="{StaticResource Primary}"
                TextColor="White"
                FontAttributes="Bold"
                HeightRequest="50"
                CornerRadius="10" />
        
        <Border Stroke="{StaticResource Gray200}" StrokeThickness="1" StrokeShape="RoundRectangle 12" HeightRequest="260" Margin="0,10" BackgroundColor="White">
            <Grid>
                <VerticalStackLayout HorizontalOptions="Center" VerticalOptions="Center" Spacing="8" IsVisible="{Binding HasNoImage}">
                    <Label Text="📷" FontSize="36" HorizontalOptions="Center" />
                    <Label Text="Chưa chọn ảnh nào" TextColor="{StaticResource Gray500}" HorizontalOptions="Center" FontAttributes="Bold" />
                    <Label Text="Nhấn nút phía trên để chọn ảnh từ thư viện" TextColor="{StaticResource Gray400}" FontSize="12" HorizontalOptions="Center" />
                </VerticalStackLayout>

                <!-- Processing state -->
                <VerticalStackLayout HorizontalOptions="Center" VerticalOptions="Center" Spacing="10" IsVisible="{Binding HasImage}">
                    <ActivityIndicator IsRunning="True" Color="{StaticResource Primary}" WidthRequest="36" HeightRequest="36" HorizontalOptions="Center" />
                    <Label Text="Đang phân tích mã trong ảnh..." TextColor="{StaticResource Gray900}" HorizontalOptions="Center" FontAttributes="Bold" />
                </VerticalStackLayout>
            </Grid>
        </Border>

        <ActivityIndicator IsRunning="{Binding IsBusy}" 
                           IsVisible="{Binding IsBusy}" 
                           HorizontalOptions="Center" 
                           Color="{StaticResource Primary}"/>

    </VerticalStackLayout>
</ContentPage>

